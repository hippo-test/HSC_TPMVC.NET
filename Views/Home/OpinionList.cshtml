@model IEnumerable<TPLOCAL1.Models.Opinion>
@{
    ViewData["Title"] = "Liste des avis";
}
<title>Liste des avis</title>
<head>
    <link rel="stylesheet" href="~/resources/Index.css" asp-append-version="true" />
</head>
<body>
    <nav>
        <ul>
            <li><a href="/Home/Index" tags>Acceuil</a></li>
            <li><a href="/Home/Index/Form">Formulaire</a></li>
        </ul>
    </nav>
    <div class="formulaire">
    <table class="table-formulaire">
        <caption>Liste</caption>
        <thead>
            <tr>
                <th>Prénom</th>
                <th>Nom</th>
                <th>Avis donné</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                if (item.OpinionGiven == "O")
                {
                    <tr>
                        <td>@item.FirstName</td>
                        <td>@item.LastName</td>
                        <td class="O">Oui</td>
                    </tr>
				}
				else
				{
				<tr>
                    <td>@item.FirstName</td>
					<td>@item.LastName</td>
					<td class="N">Non</td>
				</tr>
				}
            }
        </tbody>
    </table>
    </div>
</body>
