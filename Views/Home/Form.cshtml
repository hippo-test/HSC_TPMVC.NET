@model TPLOCAL1.Models.Infos
@{
    ViewData["Title"] = "Formulaire TP HN avis";
}
<title>Remplir le formulaire</title>
<head>
    <link rel="stylesheet" href="~/resources/Index.css" asp-append-version="true" />
</head>
<body>
        <nav>
            <ul>
                <li><a href="/Home/Index" tags>Acceuil</a></li>
                <li><a href="/Home/Index/OpinionList">Liste avis</a></li>
            </ul>
        </nav>
        <form class="formulaire" asp-action="ValidationFormulaire" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger">
        </div>
                <table class="table-formulaire">
                <caption>Informations personnelles</caption>
                <tbody>
                    <tr>
                        <td>
                            <label asp-for="prenom">Prénom</label>
                        </td>
                        <td>
                            <input asp-for="prenom" class="form-control" />
                            <span asp-validation-for="prenom"
                                  class="text-danger"></span>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label asp-for="nom">Nom</label>
                        </td>
                        <td>
                            <input asp-for="nom" class="form-control" />
                            <span asp-validation-for="nom"
                                  class="text-danger"></span>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label asp-for="genre">Genre</label>
                        </td>
                        <td>
                            <select asp-for="genre" class="form-control">
                                <option value="">-- Sélectionner un genre --</option>
                                <option value="Homme">Homme</option>
                                <option value="Femme">Femme</option>
                                <option value="Autre">Autre</option>
                            </select>
                            <span asp-validation-for="genre"
                                  class="text-danger"></span>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label asp-for="adresse">Adresse</label>
                        </td>
                        <td>
                            <input asp-for="adresse" class="form-control" />
                            <span asp-validation-for="adresse"
                                  class="text-danger"></span>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label asp-for="zipcode">Code postal</label>
                        </td>
                        <td>
                            <input asp-for="zipcode" class="form-control" />
                            <span asp-validation-for="zipcode"
                                  class="text-danger"></span>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label asp-for="ville">Ville</label>
                        </td>
                        <td>
                            <input asp-for="ville" class="form-control" />
                            <span asp-validation-for="ville"
                                  class="text-danger"></span>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label asp-for="email">Adresse e-mail</label>
                        </td>
                        <td>
                            <input asp-for="email" class="form-control" />
                            <span asp-validation-for="email"
                                  class="text-danger"></span>
                        </td>
                    </tr>
                </tbody>
                </table>
                    <table class="table-formulaire">
                    <caption>Informations formation suivie</caption>
                    <tr>
                        <td>
                            <label asp-for="startDate">Date début formation</label>
                        </td>
                        <td>
                            <input asp-for="startDate" class="form-control" />
                            <span asp-validation-for="startDate" class="text-danger"></span>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label asp-for="typetraining">Type de formation</label>
                        </td>
                        <td>
                            <select asp-for="typetraining" class="form-control">
                                <option value="">-- Sélectionner une formation --</option>
                                <option value="Cobol Training">Cobol Training</option>
                                <option value="Object Training">Object Training</option>
                                <option value="Dual Skills Training">Dual Skills Training</option>
                            </select>
                            <span asp-validation-for="typetraining" class="text-danger"></span>
                </td>
                    </tr>
                        </table>
                        <table class="table-formulaire">
                            <caption> Avis sur la formation suivie</caption>
                            <tr>
                                <td>
                                    <label asp-for="aviscb">Formation Cobol</label>
                                </td>
                                <td>
                                    <input asp-for="aviscb" class="form-control" />
                                    <span asp-validation-for="aviscb" class="text-danger"></span>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <label asp-for="aviscs">Formation C#</label>
                                </td>
                                <td>
                                    <input asp-for="aviscs" class="form-control" />
                                    <span asp-validation-for="aviscs" class="text-danger"></span>
                                </td>
                            </tr>
                        </table>
                <div class="btn">
                <button type="submit" value="ValidationFormulaire" class="btn btn-primary">
                    Valider
                </button>
                </div>
        </form>
</body>
