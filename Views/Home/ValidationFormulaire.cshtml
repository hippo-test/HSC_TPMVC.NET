
@model TPLOCAL1.Models.Infos
@{
    ViewData["Title"] = "Page de validation";
}
<title>Remplir le formulaire</title>
<head>
    <link rel="stylesheet" href="~/resources/Index.css" asp-append-version="true" />
</head>
<body>
            <caption>Votre formulaire a bien été pris en compte</caption>
            <nav>
                <ul>
                    <li><a href="/Home/Index" tags>Acceuil</a></li>
                    <li><a href="/Home/Index/OpinionList">Liste avis</a></li>
                </ul>
            </nav>
            <div class="formulaire">
            <table class="table-formulaire">    
                    <caption>Informations personnelles</caption>
                    <tbody>
                        <tr>
                            <td>
                                prenom
                            </td>
                            <td>
                            @Html.DisplayFor(model => model.prenom)
                            </td>
                        </tr>
                        <tr>
                            <td>
                                nom
                            </td>
                            <td>
                                @Html.DisplayFor(model => model.nom)
                            </td>
                        </tr>
                        <tr>
                            <td>
                                genre
                            </td>
                            <td>
                                @Html.DisplayFor(model => model.genre)
                            </td>
                        </tr>
                        <tr>
                            <td>
                                adresse
                            </td>
                            <td>
                                @Html.DisplayFor(model => model.adresse)
                            </td>
                        </tr>
                        <tr>
                            <td>
                                Code postal
                            </td>
                            <td>
                                @Html.DisplayFor(model => model.zipcode)
                            </td>
                        </tr>
                        <tr>
                            <td>
                                ville
                            </td>
                            <td>
                                @Html.DisplayFor(model => model.ville)
                            </td>
                        </tr>
                        <tr>
                            <td>
                                email
                            </td>
                            <td>
                                @Html.DisplayFor(model => model.email)
                            </td>
                        </tr>
                        </tbody>
                        </table>
                    <table class="table-formulaire">
                        <caption>Informations formation suivie</caption>
                        <tbody>
                            <tr>
                                <td>
                                    date de debut
                                </td>
                                <td>
                                    @Html.DisplayFor(model => model.startDate)
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    type de formation
                                </td>
                                <td>
                                    @Html.DisplayFor(model => model.typetraining)
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table class="table-formulaire">
                        <caption>Avis sur la formation</caption>
                        <tbody>
                            <tr>
                                <td>
                                    avis formation Cobol
                                </td>
                                <td>
                                    @Html.DisplayFor(model => model.aviscb)
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    avis formation csharp
                                </td>
                                <td>
                                    @Html.DisplayFor(model => model.aviscs)
                                </td>
                            </tr>
                        </tbody>
                    </table>
            </div>
</body>



    
